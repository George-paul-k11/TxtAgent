      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('状态码 400', function () { pm.response.to.have.status(400); });",
              "pm.test('提示上传文件', function () {",
